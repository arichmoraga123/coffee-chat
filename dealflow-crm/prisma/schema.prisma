// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  email                     String                   @unique
  passwordHash              String
  role                      String                   @default("USER")
  drillStreak               Int                      @default(0)
  lastDrillDay              String? // YYYY-MM-DD (UTC)
  xp                        Int                      @default(0)
  weeklyXP                  Int                      @default(0)
  recruitingTarget          String[]                 @default([])
  /**
   * Primary career paths for filtering prep (DB column legacy name `preferredTracks`).
   */
  careerTracks              String[]                 @default([]) @map("preferredTracks")
  schoolId                  String?
  eduEmail                  String?
  eduVerified               Boolean                  @default(false)
  eduVerificationToken      String?
  eduVerificationExpires    DateTime?
  contributionXP            Int                      @default(0)
  bio                       String?
  referralCode              String?                  @unique
  targetFirms               String[]                 @default([])
  dailyGoal                 Int                      @default(5)
  onboardingDone            Boolean                  @default(false)
  accountActive             Boolean                  @default(true)
  lastActiveAt              DateTime?
  /// Soft delete from the bot review page (account hidden and disabled). Purged only by an explicit admin action.
  deletedAt                 DateTime?
  /// Marked "Keep" on the bot review page.
  reviewedKeep              Boolean                  @default(false)
  signupIp                  String?
  classYear                 Int?
  /// Desktop sidebar collapsed to the icon rail (null = not chosen yet)
  sidebarCollapsed          Boolean?
  /// PE@Broad sharing settings
  shareLearning             Boolean                  @default(true)
  shareDrill                Boolean                  @default(true)
  shareTargets              Boolean                  @default(true)
  /// null = not asked yet
  shareFirms                Boolean?
  /// Opportunity roles the user added themselves
  customRoles               String[]                 @default([])
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  school                    School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  clubMemberships           ClubMember[]
  compData                  CompData[]
  compDataUpvotes           CompDataUpvote[]
  referralsGiven            Referral[]               @relation("Referrer")
  referralsReceived         Referral[]               @relation("Referee")
  clubPostsAuthored         ClubPost[]               @relation("ClubPostAuthor")
  clubAnnouncementsAuthored ClubAnnouncement[]       @relation("ClubAnnouncementAuthor")
  contacts                  Contact[]
  contactEmailDrafts        ContactEmailDraft[]
  firms                     Firm[]
  interactions              Interaction[]
  opportunities             Opportunity[]
  tasks                     Task[]
  questionProgress          UserQuestionProgress[]
  lessonProgress            LessonProgress[]
  questionAttempts          QuestionAttempt[]
  dailyQuestionSets         DailyQuestionSet[]
  clubActivities            ClubActivity[]
  activityReactions         ClubActivityReaction[]
  conversationMemberships   ConversationMember[]
  messagesSent              Message[]
  challengesCreated         Challenge[]              @relation("ChallengeCreator")
  challengeParticipations   ChallengeParticipant[]
  challengeAnswers          ChallengeAnswer[]
  stories                   Story[]
  importBatches             ImportBatch[]
  notifications             Notification[]
  notificationPref          NotificationPref?
  openingReminders          OpeningReminder[]
  workbookProgress          WorkbookProgress[]
  clubPostProgress          ClubPostProgress[]
  clubJoinRequests          ClubJoinRequest[]
  reviewItems               ReviewItem[]
  mentorQuestions           MentorQuestion[]         @relation("MentorQuestionAsker")
  resourceBookmarks         ResourceBookmark[]
  timelinesSubmitted        FirmTimeline[]           @relation("TimelineSubmitter")
  timelineVotes             FirmTimelineVote[]
  dailyDrillLogs            DailyDrillLog[]
  leaderboardEntry          LeaderboardEntry?
  recruitingEvents          RecruitingEvent[]
  submittedQuestions        Question[]               @relation("QuestionSubmitter")
  mockInterviewSessions     MockInterviewSession[]
  mockInterviewQuestions    MockInterviewQuestion[]  @relation("MockInterviewQuestionSubmitter")
  interviewDebriefs         InterviewDebrief[]
  templateUpvotes           TemplateUpvote[]
  dealBookmarks             DealBookmark[]
  vaultDocumentUpvotes      VaultDocumentUpvote[]
  studyGroupMembers         StudyGroupMember[]
  studyGroupsCreated        StudyGroup[]             @relation("StudyGroupCreator")
  studyGroupMessages        StudyGroupMessage[]
  offerComparisons          OfferComparison[]
  apiUsageLogs              ApiUsageLog[]
  contentReports            ContentReport[]          @relation("ContentReportReporter")
  calendarIntegrations      CalendarIntegration[]
  resumeReviews             ResumeReview[]
  caseCompetitions          CaseCompetition[]
  recruitingCalendarVotes   RecruitingCalendarVote[]
  stockPitches              StockPitch[]
}

model Question {
  id            String                 @id @default(cuid())
  question      String
  answer        String
  keywords      String[]               @default([])
  category      String
  subcategory   String?
  difficulty    String
  tags          String[]
  /**
   * Empty = relevant to all tracks. Otherwise show only if user selected a matching track.
   */
  careerTracks  String[]               @default([])
  source        String?
  status        String                 @default("active") // active | pending | rejected
  dedupeKey     String?                @unique
  submittedById String?
  schoolId      String?
  scope         String                 @default("global") // global | school | club
  upvotes       Int                    @default(0)
  /// Hand-written MCQ options (exactly 4). Only questions with mcqEligible = true are shown as MCQs.
  options       String[]               @default([])
  correctIndex  Int?
  explanation   String?
  /// Learn lesson this question belongs to, e.g. "2-2"
  lessonId      String?
  mcqEligible   Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
  userProgress  UserQuestionProgress[]
  attempts      QuestionAttempt[]
  submitter     User?                  @relation("QuestionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  school        School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
}

model UserQuestionProgress {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  status     String // "known" | "review" | "unseen"
  lastSeen   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model DailyDrillLog {
  id                String @id @default(cuid())
  userId            String
  date              String // YYYY-MM-DD UTC
  questionsAnswered Int
  correct           Int
  xpEarned          Int
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaderboardEntry {
  id       String @id @default(cuid())
  userId   String @unique
  username String
  weeklyXP Int    @default(0)
  totalXP  Int    @default(0)
  streak   Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   @unique
  source      String
  publishedAt DateTime
  category    String // M&A | PE/VC | Markets | Banking
  imageUrl    String?
  cachedAt    DateTime @default(now())
}

model RecruitingEvent {
  id                     String   @id @default(cuid())
  userId                 String
  title                  String
  date                   DateTime
  type                   String // coffee_chat | deadline | interview | networking | other
  firmName               String?
  notes                  String?
  googleCalendarEventId  String?
  outlookCalendarEventId String?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResourceBookmark {
  id           String @id @default(cuid())
  userId       String
  resourceSlug String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceSlug])
}

model FirmTimeline {
  id               String             @id @default(cuid())
  firmName         String
  firmType         String // BB, EB, MM, PE, VC
  role             String
  applicationOpen  DateTime?
  applicationClose DateTime?
  firstRound       DateTime?
  finalRound       DateTime?
  offerDate        DateTime?
  year             Int
  notes            String?
  careerTracks     String[]           @default([])
  schoolId         String?
  scope            String             @default("global") // global | school | club
  submittedBy      String?
  verified         Boolean            @default(false)
  upvotes          Int                @default(0)
  createdAt        DateTime           @default(now())
  submitter        User?              @relation("TimelineSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  school           School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  votes            FirmTimelineVote[]
}

model FirmTimelineVote {
  id         String       @id @default(cuid())
  userId     String
  timelineId String
  timeline   FirmTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, timelineId])
}

enum FirmType {
  IB
  PE
  GE
  VC
  HF
  CONSULTING
  CORPORATE
  OTHER
}

enum RecruitingCategory {
  IB
  PE
  GE
  VC
  HF
}

enum ReferralProbability {
  LOW
  MEDIUM
  HIGH
}

enum InteractionType {
  COFFEE_CHAT
  CALL
  EMAIL
  LINKEDIN
  IN_PERSON
}

enum OpportunityStage {
  TARGET
  NETWORKING
  APPLIED
  FIRST_ROUND
  TECHNICAL
  SUPERDAY
  OFFER
  REJECTED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  FOLLOW_UP
  THANK_YOU
  CHECK_IN
  APPLY
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Contact {
  id                   String              @id @default(cuid())
  fullName             String
  email                String
  phone                String?
  linkedinUrl          String?
  group                String
  title                String
  location             String
  school               String
  recruitingCategory   RecruitingCategory
  relationshipStrength Int                 @default(1)
  referralProbability  ReferralProbability
  notes                String              @default("")
  lastInteractionDate  DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  firmId               String
  userId               String

  undergradSchool String?
  gradSchool      String?
  graduationYear  Int?
  hometown        String?
  previousFirms   String[] @default([])
  careerPath      String?

  clubs     String[] @default([])
  sports    String[] @default([])
  greekLife String?

  howWeMet          String?
  referredBy        String?
  mutualConnections String[] @default([])
  warmthScore       String   @default("COLD") // COLD | WARM | HOT | ADVOCATE

  hiringTimeline    String?
  whatTheyLookFor   String?
  referralPotential String?
  openRoles         String?

  notableDeals String[] @default([])

  source          String? // "manual", "import", "linkedin", "linkedin-search"
  inOutreachQueue Boolean @default(false)
  queueExcluded   Boolean @default(false)

  /// "active" (default) or "network" (connected, not actively working: no reminders, not in the default view)
  list              String       @default("active")
  doNotContact      Boolean      @default(false)
  notPursuing       Boolean      @default(false)
  /// A / B / C — sets the check-in cadence (6 / 8 / 12 weeks)
  priority          String?
  /// Emailed – no reply | Replied | Chatted | Referred me | Interviewing (from import or derived)
  relationshipStage String?
  tags              String[]     @default([])
  connectedOn       DateTime?
  /// Soft delete; purged after 30 days from Trash.
  deletedAt         DateTime?
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  firm          Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions  Interaction[]
  tasks         Task[]
  opportunities OpportunityContact[]
  emailDrafts   ContactEmailDraft[]

  @@unique([userId, email])
}

model ContactEmailDraft {
  id           String   @id @default(cuid())
  contactId    String
  userId       String
  templateType String
  content      String
  createdAt    DateTime @default(now())
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Firm {
  id              String        @id @default(cuid())
  name            String
  type            FirmType?
  location        String
  aum             String?
  focus           String
  recruitingNotes String        @default("")
  createdAt       DateTime      @default(now())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  opportunities   Opportunity[]

  @@unique([userId, name])
}

model Interaction {
  id                     String          @id @default(cuid())
  date                   DateTime
  type                   InteractionType
  notes                  String?
  adviceGiven            String?
  actionItems            String[]        @default([])
  actionItemsChecked     Int[]           @default([])
  personalDetails        String?
  firmInsights           String?
  redFlags               String?
  followUpDate           DateTime?
  googleCalendarEventId  String?
  outlookCalendarEventId String?
  createdAt              DateTime        @default(now())
  contactId              String
  userId                 String
  /// Fine-grained type: cold_email | linkedin_message | followup_email | replied | coffee_chat | phone_call | video_call | in_person | thank_you | referral | interview | event
  kind                   String?
  nextStep               String?
  nextStepDue            DateTime?
  /// True for rows the old importer created automatically (no real conversation).
  autoCreated            Boolean         @default(false)
  deletedAt              DateTime?
  importBatchId          String?
  importBatch            ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  contact                Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id                     String               @id @default(cuid())
  role                   String
  stage                  OpportunityStage     @default(TARGET)
  priority               Priority             @default(MEDIUM)
  notes                  String               @default("")
  applicationDeadline    DateTime?
  googleCalendarEventId  String?
  outlookCalendarEventId String?
  contactName            String               @default("")
  group                  String?
  location               String?
  createdAt              DateTime             @default(now())
  firmId                 String
  userId                 String
  /// Set when added from the Openings page.
  openingId              String?
  firm                   Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  opening                Opening?             @relation(fields: [openingId], references: [id], onDelete: SetNull)
  contacts               OpportunityContact[]

  @@index([userId, openingId])
}

model OpportunityContact {
  opportunityId String
  contactId     String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([opportunityId, contactId])
}

model Task {
  id           String     @id @default(cuid())
  dueDate      DateTime
  taskType     TaskType
  status       TaskStatus @default(PENDING)
  notes        String     @default("")
  contactId    String
  userId       String
  /// manual | followup (from the follow-up rules) | next_step (from an import or logged interaction)
  kind         String     @default("manual")
  /// Which follow-up rule produced it (e.g. "bump1:<interactionId>"); one open task per rule.
  ruleKey      String?
  reason       String?
  snoozedUntil DateTime?
  completedAt  DateTime?
  dismissedAt  DateTime?
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contactId, ruleKey])
  @@index([userId, status, dueDate])
}

// --- Recruiting Hub: shared question bank, private sessions ---
model MockInterviewQuestion {
  id            String   @id @default(cuid())
  question      String
  category      String
  bankSource    String
  year          Int?
  difficulty    String
  modelAnswer   String?
  tips          String?
  careerTracks  String[] @default([])
  upvotes       Int      @default(0)
  submittedById String?
  status        String   @default("active")
  dedupeKey     String?  @unique
  createdAt     DateTime @default(now())
  submitter     User?    @relation("MockInterviewQuestionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([bankSource, status])
  @@index([status])
}

model MockInterviewSession {
  id          String   @id @default(cuid())
  userId      String
  mode        String
  bankFilter  String?
  questions   String[]
  scores      Json
  duration    Int
  aiSummary   String?
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InterviewDebrief {
  id             String   @id @default(cuid())
  userId         String
  firmName       String
  round          String
  date           DateTime
  questionsAsked String[]
  myAnswers      String?
  whatWentWell   String?
  improvements   String?
  outcome        String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Shared firm research wiki ---
model FirmResearch {
  id               String   @id @default(cuid())
  firmName         String   @unique
  firmType         String
  aum              String?
  founded          Int?
  headquarters     String?
  description      String?
  investmentFocus  String?
  dealSize         String?
  notableDeals     String[] @default([])
  whatTheyLookFor  String?
  hiringTimeline   String?
  interviewProcess String?
  culture          String?
  msuAlumni        String[] @default([])
  websiteUrl       String?
  linkedinUrl      String?
  lastUpdated      DateTime @default(now())
  updatedById      String?
}

// --- Shared email templates ---
model EmailTemplate {
  id            String           @id @default(cuid())
  title         String
  category      String
  subject       String?
  body          String
  tags          String[]         @default([])
  upvotes       Int              @default(0)
  submittedById String?
  isOfficial    Boolean          @default(false)
  dedupeKey     String?          @unique
  archived      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  upvotedBy     TemplateUpvote[]

  @@index([archived])
}

model TemplateUpvote {
  id         String        @id @default(cuid())
  userId     String
  templateId String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

// --- Shared deals, private bookmarks ---
model Deal {
  id           String         @id @default(cuid())
  title        String         @unique
  acquirer     String?
  target       String?
  dealValue    String?
  dealType     String
  vertical     String?
  sector       String?
  summary      String
  keyThesis    String?
  risks        String?
  sourceUrl    String?
  announcedAt  DateTime
  status       String         @default("draft") // draft | published
  careerTracks String[]       @default([])
  dedupeKey    String?        @unique
  createdAt    DateTime       @default(now())
  bookmarks    DealBookmark[]

  @@index([status])
}

model ConsultingCase {
  id           String   @id @default(cuid())
  title        String
  type         String
  difficulty   String
  prompt       String   @db.Text
  framework    String?  @db.Text
  sampleAnswer String?  @db.Text
  firmSource   String?
  isShared     Boolean  @default(true)
  dedupeKey    String?  @unique
  careerTracks String[] @default(["Consulting"])
  createdAt    DateTime @default(now())
}

model StockPitch {
  id              String      @id @default(cuid())
  userId          String
  companyName     String
  overview        String      @db.Text
  thesisBullets   String[]    @default([])
  currentPrice    String?
  targetPrice     String?
  catalysts       String[]    @default([])
  risks           String[]    @default([])
  recommendation  String
  deckOutline     String?     @db.Text
  sharedToGroupId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGroup      StudyGroup? @relation(fields: [sharedToGroupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sharedToGroupId])
}

model DealBookmark {
  id     String  @id @default(cuid())
  userId String
  dealId String
  notes  String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal   Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
}

// --- Shared vault (anonymized metadata); submitter id stored for moderation ---
model VaultDocument {
  id            String                @id @default(cuid())
  type          String
  targetFirm    String?
  targetRole    String?
  outcome       String?
  year          Int?
  school        String?
  fileUrl       String?
  notes         String?
  upvotes       Int                   @default(0)
  submittedById String?
  dedupeKey     String?               @unique
  status        String                @default("active") // active | pending | rejected
  createdAt     DateTime              @default(now())
  upvotedBy     VaultDocumentUpvote[]

  @@index([status])
}

model VaultDocumentUpvote {
  id         String        @id @default(cuid())
  userId     String
  documentId String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   VaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

// --- Study groups: visible to members only ---
model StudyGroup {
  id            String              @id @default(cuid())
  name          String
  createdBy     String
  createdAt     DateTime            @default(now())
  creator       User                @relation("StudyGroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       StudyGroupMember[]
  messages      StudyGroupMessage[]
  sharedPitches StockPitch[]
}

model StudyGroupMember {
  id      String     @id @default(cuid())
  groupId String
  userId  String
  role    String     @default("member")
  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model StudyGroupMessage {
  id        String     @id @default(cuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime   @default(now())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

// --- Private offer comparison ---
model OfferComparison {
  id         String   @id @default(cuid())
  userId     String
  offers     Json
  aiAnalysis String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  feature      String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([feature])
}

model ContentReport {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("pending") // pending | reviewed | dismissed
  createdAt  DateTime @default(now())
  reporter   User     @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
}

// --- External calendars (Google + Outlook) — one row per provider per user ---
model CalendarIntegration {
  id           String    @id @default(cuid())
  userId       String
  provider     String // "google" | "outlook"
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  expiresAt    DateTime
  calendarId   String?
  syncEnabled  Boolean   @default(true)
  lastSynced   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// --- AI resume review (last 5 per user enforced in app) ---
model ResumeReview {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  score     Int
  feedback  Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// --- Case competitions (private) ---
model CaseCompetition {
  id            String   @id @default(cuid())
  userId        String
  name          String
  organizer     String?
  date          DateTime
  teamMembers   String[] @default([])
  role          String?
  topic         String?
  result        String?
  description   String?
  driveLink     String?
  skills        String[] @default([])
  addToResume   Boolean  @default(false)
  resumeBullets String[] @default([])
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Shared recruiting season calendar (crowdsourced) ---
model RecruitingCalendarEvent {
  id          String                   @id @default(cuid())
  title       String
  firmName    String?
  vertical    String?
  eventType   String
  date        DateTime
  endDate     DateTime?
  year        Int
  isRecurring Boolean                  @default(false)
  notes       String?
  sourceUrl   String?
  submittedBy String?
  verified    Boolean                  @default(false)
  upvotes     Int                      @default(0)
  dedupeKey   String?                  @unique
  createdAt   DateTime                 @default(now())
  votes       RecruitingCalendarVote[]

  @@index([year, date])
  @@index([vertical])
}

model RecruitingCalendarVote {
  id      String                  @id @default(cuid())
  userId  String
  eventId String
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   RecruitingCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

// --- Prospect: multi-school network ---
model School {
  id         String         @id @default(cuid())
  name       String         @unique
  shortName  String
  domain     String         @unique
  location   String?
  country    String         @default("US")
  type       String         @default("semi-target") // target | semi-target | non-target
  logoUrl    String?
  isVerified Boolean        @default(false)
  createdAt  DateTime       @default(now())
  members    User[]
  clubs      Club[]
  questions  Question[]
  timelines  FirmTimeline[]
  compData   CompData[]
  alumni     SchoolAlumni[]
}

model Club {
  id                   String             @id @default(cuid())
  schoolId             String
  name                 String
  type                 String
  description          String?
  logoUrl              String?
  isVerified           Boolean            @default(false)
  isPublic             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members              ClubMember[]
  posts                ClubPost[]
  projects             ClubProject[]
  events               ClubEvent[]
  announcements        ClubAnnouncement[]
  rosterEntries        ClubRosterEntry[]
  activities           ClubActivity[]
  conversations        Conversation[]
  challenges           Challenge[]
  joinRequests         ClubJoinRequest[]
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  @@unique([schoolId, name])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     String   @default("member")
  /// false when the member's roster entry is deactivated (their data is kept)
  active   Boolean  @default(true)
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model ClubPost {
  id         String             @id @default(cuid())
  clubId     String
  authorId   String
  title      String
  content    String             @db.Text
  type       String
  dueDate    DateTime?
  driveLink  String?
  isPinned   Boolean            @default(false)
  readBy     String[]           @default([])
  createdAt  DateTime           @default(now())
  club       Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author     User               @relation("ClubPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// [{ name, url, size, contentType }] stored in Vercel Blob
  files      Json               @default("[]")
  links      String[]           @default([])
  tags       String[]           @default([])
  lessonIds  String[]           @default([])
  /// { all: true } | { tracks: string[] } | { userIds: string[] }
  audience   Json               @default("{\"all\":true}")
  allowDone  Boolean            @default(false)
  archivedAt DateTime?
  progress   ClubPostProgress[]

  @@index([clubId, createdAt])
}

model ClubProject {
  id           String            @id @default(cuid())
  clubId       String
  title        String
  description  String?           @db.Text
  dueDate      DateTime?
  memberIds    String[]          @default([])
  driveLink    String?
  status       String            @default("active")
  leadId       String?
  files        Json              @default("[]")
  links        String[]          @default([])
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  deliverables ClubDeliverable[]

  @@index([clubId])
}

model ClubDeliverable {
  id         String      @id @default(cuid())
  projectId  String
  title      String
  assignedTo String[]    @default([])
  dueDate    DateTime?
  status     String      @default("pending")
  driveLink  String?
  project    ClubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ClubEvent {
  id             String    @id @default(cuid())
  clubId         String
  title          String
  description    String?   @db.Text
  date           DateTime
  location       String?
  type           String
  rsvpIds        String[]  @default([])
  capacity       Int?
  materialsLink  String?
  endDate        DateTime?
  meetingLink    String?
  rsvpOn         Boolean   @default(true)
  declinedIds    String[]  @default([])
  reminderSentAt DateTime?
  createdById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, date])
}

model ClubAnnouncement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  title     String
  body      String   @db.Text
  isPinned  Boolean  @default(false)
  readBy    String[] @default([])
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author    User     @relation("ClubAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

model CompData {
  id             String           @id @default(cuid())
  userId         String
  schoolId       String?
  firmName       String
  role           String
  vertical       String
  officeLocation String?
  baseComp       Int?
  signingBonus   Int?
  yearEndBonus   Int?
  totalComp      Int?
  year           Int
  anonymous      Boolean          @default(true)
  verified       Boolean          @default(false)
  upvotes        Int              @default(0)
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  upvotedBy      CompDataUpvote[]

  @@index([year, firmName])
}

model CompDataUpvote {
  id     String   @id @default(cuid())
  userId String
  compId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comp   CompData @relation(fields: [compId], references: [id], onDelete: Cascade)

  @@unique([userId, compId])
}

model SchoolAlumni {
  id          String  @id @default(cuid())
  schoolId    String
  firmName    String
  role        String
  vertical    String
  gradYear    Int?
  linkedinUrl String?
  openToChat  Boolean @default(false)
  anonymous   Boolean @default(false)
  submittedBy String?
  verified    Boolean @default(false)
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, firmName])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String?
  code       String   @unique
  status     String   @default("pending")
  xpAwarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User?    @relation("Referee", fields: [refereeId], references: [id], onDelete: SetNull)
}

// ── Prospect Learn ─────────────────────────────────────────────

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("in_progress") // in_progress | completed
  /// { [blockId]: { done, attempts, correct, opened?, step?, marks? } }
  blockState  Json      @default("{}")
  /// % of graded blocks correct on first or second try
  score       Int       @default(0)
  /// Deep dives that have earned XP (max 3 per lesson)
  deepDiveXp  Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model ReviewItem {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  blockId   String
  prompt    String
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, blockId, prompt])
  @@index([userId, resolved])
}

model LessonResource {
  id          String   @id @default(cuid())
  workbookKey String // e.g. "PEB_03_CAPM_Beta_WACC"
  kind        String // "student" | "answer_key"
  title       String
  description String?
  blobUrl     String
  fileName    String
  sizeBytes   Int
  version     Int      @default(1)
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@unique([workbookKey, kind, version])
}

model ResourceDownload {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  @@index([resourceId])
}

model MentorQuestion {
  id         String    @id @default(cuid())
  userId     String
  lessonId   String
  blockId    String?
  question   String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  status     String    @default("open") // open | answered
  /// When true the Q&A is shown on the lesson as an FAQ deep dive for everyone
  public     Boolean   @default(false)
  seenByUser Boolean   @default(false)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation("MentorQuestionAsker", fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, status])
  @@index([userId])
}

// ── PE@Broad club: question bank + roster ─────────────────────

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  correct    Boolean
  chosenText String
  msToAnswer Int
  context    String // "drill" | "practice" | "challenge"
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, createdAt])
}

/// The 5 questions picked for a user's daily set, fixed for the day so a refresh doesn't reshuffle.
model DailyQuestionSet {
  id          String   @id @default(cuid())
  userId      String
  date        String // YYYY-MM-DD (UTC)
  questionIds String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ClubRosterEntry {
  id      String   @id @default(cuid())
  clubId  String
  email   String // lowercase
  name    String?
  role    String   @default("member") // "member" | "admin"
  active  Boolean  @default(true)
  addedAt DateTime @default(now())
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, email])
}

model ClubJoinRequest {
  id        String    @id @default(cuid())
  clubId    String
  userId    String
  status    String    @default("pending") // pending | approved | denied
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  decidedBy String?
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, status])
}

/// PE@Broad activity feed: lesson/module completions, challenge results, streak milestones, new members.
model ClubActivity {
  id        String                 @id @default(cuid())
  clubId    String
  userId    String
  kind      String // lesson_complete | module_complete | challenge_result | streak | joined | weekly_challenge
  data      Json                   @default("{}")
  createdAt DateTime               @default(now())
  club      Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ClubActivityReaction[]

  @@index([clubId, createdAt])
}

model ClubActivityReaction {
  activityId String
  userId     String
  emoji      String
  createdAt  DateTime     @default(now())
  activity   ClubActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([activityId, userId])
}

model Conversation {
  id            String               @id @default(cuid())
  clubId        String
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime             @default(now())
  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)
  /// This member blocked the other person: no new messages either way.
  blocked        Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  kind           String       @default("text") // text | challenge
  challengeId    String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Challenge {
  id                String                 @id @default(cuid())
  clubId            String
  mode              String // async | live | weekly
  createdById       String
  /// { modules?: number[], lessons?: string[], categories?: string[], difficulty?: string, label?: string }
  topic             Json                   @default("{}")
  questionIds       String[]
  secondsPerQ       Int                    @default(30)
  status            String                 @default("pending") // pending | accepted | live | complete | expired | declined
  expiresAt         DateTime
  currentIndex      Int                    @default(0)
  questionStartedAt DateTime?
  createdAt         DateTime               @default(now())
  club              Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy         User                   @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants      ChallengeParticipant[]
  answers           ChallengeAnswer[]

  @@index([clubId, mode, createdAt])
}

model ChallengeParticipant {
  challengeId String
  userId      String
  score       Int       @default(0)
  totalMs     Int       @default(0)
  ready       Boolean   @default(false)
  lastSeenAt  DateTime?
  finishedAt  DateTime?
  xpAwarded   Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
}

model ChallengeAnswer {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  questionId  String
  correct     Boolean
  chosenText  String    @default("")
  ms          Int
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, questionId])
}

/// Storybank: a behavioral story the student drafts ("word vomit") and the AI cleans up.
model Story {
  id        String   @id @default(cuid())
  userId    String
  /// Which of the 6 prompted slots this is (leadership, teamwork, failure, conflict, initiative, why-finance) or "custom"
  slot      String
  title     String   @default("")
  rawText   String   @default("")
  /// AI-cleaned version: { situation, task, action, result, oneLiner, twoMinute }
  polished  Json?
  /// Behavioral questions this story answers, with a short angle for each: [{ question, angle }]
  questions Json     @default("[]")
  /// Coaching notes: what's missing / what to sharpen
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One upload of contacts/interactions, so it can be listed and undone.
model ImportBatch {
  id           String        @id @default(cuid())
  userId       String
  source       String // rolodex_template | linkedin | csv
  fileName     String
  /// { contactsNew, contactsUpdated, interactions, tasks, skipped, errors }
  counts       Json          @default("{}")
  status       String        @default("complete") // complete | undone
  /// Openings uploads: { created: id[], updated: { id, before }[], archived: id[] } so the upload can be undone.
  undoData     Json?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  interactions Interaction[]

  @@index([userId, createdAt])
}

// --- Recruiting openings (bulk uploaded by admins/officers, Part B) ---
/// Firms are per user in this app, so an opening stores the firm name; members match it to their own firm list.
model Opening {
  id               String            @id @default(cuid())
  /// null = visible to everyone; PE@Broad uploads set the club.
  clubId           String?
  firmName         String
  /// normalizeFirmName(firmName), for matching and de-duplication.
  firmNorm         String
  program          String
  /// Summer Analyst | Sophomore / early insight program | Diversity program | Off-cycle internship | Full-time Analyst | Externship / spring week | Other
  roleType         String?
  track            String?
  group            String?
  /// Freshman | Sophomore | Junior | Senior
  classYears       String[]          @default([])
  recruitingSummer Int?
  city             String
  opensOn          DateTime?
  deadline         DateTime?
  /// Fixed | Rolling | Unknown
  deadlineType     String            @default("Unknown")
  /// Only when the file sets Status (Not yet open | Open | Closed).
  statusOverride   String?
  link             String?
  source           String?
  notes            String?
  /// clubId|firmNorm|program|city|summer (lowercased): one opening per Firm + Program + City + Recruiting Summer.
  dedupeKey        String            @unique
  importBatchId    String?
  createdById      String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reminders        OpeningReminder[]
  opportunities    Opportunity[]

  @@index([archivedAt, deadline])
  @@index([firmNorm])
}

model OpeningReminder {
  userId           String
  openingId        String
  remindOpen       Boolean   @default(true)
  remindDaysBefore Int       @default(7)
  openSentAt       DateTime?
  deadlineSentAt   DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  opening          Opening   @relation(fields: [openingId], references: [id], onDelete: Cascade)

  @@id([userId, openingId])
  @@index([openingId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPref {
  userId           String    @id
  timezone         String    @default("America/New_York")
  email            Boolean   @default(true)
  sms              Boolean   @default(false)
  phone            String?
  phoneVerifiedAt  DateTime?
  smsConsentAt     DateTime?
  smsConsentText   String?
  quietStart       Int       @default(21)
  quietEnd         Int       @default(8)
  followupDigest   Boolean   @default(true)
  mentorAlerts     Boolean   @default(true)
  clubPosts        Boolean   @default(true)
  challenges       Boolean   @default(true)
  messages         Boolean   @default(true)
  eventReminders   Boolean   @default(true)
  /// Per-category unsubscribe token for email links
  unsubscribeToken String    @unique @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Outbound email/SMS queue (sent by the notify() worker; SMS waits for quiet hours to end).
model OutboundMessage {
  id        String    @id @default(cuid())
  userId    String
  channel   String // email | sms
  kind      String
  subject   String?
  body      String
  url       String?
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([sentAt, sendAfter])
  @@index([userId, channel, createdAt])
}

/// Members marking a club post done, viewing it, and downloading its files.
model ClubPostProgress {
  postId    String
  userId    String
  viewedAt  DateTime?
  doneAt    DateTime?
  downloads Int       @default(0)
  post      ClubPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// Guided in-browser Excel: a student's saved cells and finished steps for one workbook.
model WorkbookProgress {
  userId           String
  workbookKey      String
  /// { "Sheet!A1": "=B2*C3" | 123 | "text" }
  entries          Json      @default("{}")
  completedStepIds String[]  @default([])
  firstTryStepIds  String[]  @default([])
  xpAwarded        Int       @default(0)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workbookKey])
}
